# ============================================================
# TaskDoneSaaS Frontend - Environment Variables Template
# ============================================================
# Copy this to .env and fill in your values.
# ============================================================

# For VPS with Nginx reverse proxy on same domain, use:
VITE_API_BASE_URL=/api

# For development with backend on different port:
# VITE_API_BASE_URL=http://localhost:8080/api

# IMPORTANT: On VPS with reverse proxy, the frontend automatically
# uses the current domain + /api for API calls. No changes needed
# if using the provided Nginx config.

# Optional runtime override (can be set from hosting template):
# window.__TASKDONE_API_BASE_URL__ = "https://api.yourdomain.com/api"
