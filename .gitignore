# ================================================
# TaskDoneSaaS - Git Ignore
# ================================================

# Node Modules (both backend and frontend)
**/node_modules/
backend/node_modules/
frontend/node_modules/

# Build Outputs
**/dist/
frontend/dist/

# Environment Files (NEVER commit these)
.env
.env.*
.env.local
.env.production
.env.development
*.env
backend/.env
frontend/.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2.log
pm2-error.log

# OS Files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Git
*.orig

# Misc
*.bak
*.tmp
*.temp
.cache/
