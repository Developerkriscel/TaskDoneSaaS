NODE_ENV=production
PORT=8080

# Required
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/taskdone?retryWrites=true&w=majority
JWT_SECRET=replace-with-long-random-secret

# Auth/session behavior
JWT_EXPIRES_IN=1d
COOKIE_AUTH_ENABLED=false
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# CORS
CORS_ALLOW_ANY_ORIGIN=false
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# Optional: Redis cache (recommended for production)
REDIS_URL=redis://default:password@127.0.0.1:6379

# Optional: AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional: Google Sheets FMS connector
FMS_DEFAULT_RANGE=FMS!A2:M
FMS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: Cloudinary attachments
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: SMTP fallback (can also be managed in App Settings)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Bootstrap app admin script (default: only App Admin is managed)
BOOTSTRAP_INCLUDE_SUPERADMIN=false
BOOTSTRAP_SUPERADMIN_NAME=Super Admin
BOOTSTRAP_SUPERADMIN_NUMBER=9999999999
BOOTSTRAP_SUPERADMIN_USERID=superadmin
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@yourdomain.com
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_APPADMIN_NAME=App Admin
BOOTSTRAP_APPADMIN_NUMBER=8888888888
BOOTSTRAP_APPADMIN_USERID=appadmin
BOOTSTRAP_APPADMIN_EMAIL=appadmin@yourdomain.com
BOOTSTRAP_APPADMIN_PASSWORD=ChangeMe123!

# Optional: App Admin credential rotation script
APPADMIN_PREVIOUS_USERID=appadmin
APPADMIN_TARGET_USERID=appadmin
APPADMIN_TARGET_PASSWORD=ChangeMe123!
APPADMIN_TARGET_EMAIL=appadmin@yourdomain.com
APPADMIN_TARGET_NAME=App Admin
APPADMIN_TARGET_NUMBER=8888888888
